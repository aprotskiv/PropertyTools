<Window x:Class="PropertyTools.Wpf.PropertyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pt="clr-namespace:PropertyTools.Wpf"
        Title="Properties"
        Height="400" Width="700" MinWidth="480" MinHeight="320" MaxWidth="800" MaxHeight="800" ResizeMode="CanResizeWithGrip"
        SizeToContent="WidthAndHeight" WindowStyle="SingleBorderWindow" WindowState="Normal"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=PropertyGrid1}"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Width" Value="72" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
		<Button Name="OkButton" IsDefault="True" Click="OkButtonClick" Content="{Binding Path=OKButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
		<!-- Click="CancelButtonClick" is not needed when IsCancel="True"  -->
		<Button Name="CancelButton" IsCancel="True" Content="{Binding Path=CancelButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
		<Button Name="ApplyButton" Click="ApplyButtonClick" Content="{Binding Path=ApplyButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
		<Button Name="CloseButton" Click="CloseButtonClick" Content="{Binding Path=CloseButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
		<Button Name="HelpButton" Click="HelpButtonClick" Content="{Binding Path=HelpButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
	</StackPanel>
    <pt:PropertyGrid x:Name="PropertyGrid1" SelectedObject="{Binding}" Margin="8" />
  </DockPanel>
</Window>