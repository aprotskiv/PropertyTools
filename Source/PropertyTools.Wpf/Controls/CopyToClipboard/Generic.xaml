<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:local="clr-namespace:PropertyTools.Wpf">

	<local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" NullVisibility="Collapsed"/>

	<Style TargetType="{x:Type local:CopyToClipboardText}">
		<Setter Property="MinWidth" Value="30" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:CopyToClipboardText}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<local:TextBoxEx 
							Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" 
							IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="{Binding TextWrapping, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
						>
							<local:TextBoxEx.Style>
								<Style TargetType="local:TextBoxEx">
									<!-- Triggers to alter appearance based on state -->
									<Style.Triggers>
										<Trigger Property="IsReadOnly" Value="True">
											<!-- Visual cues for read-only state -->
											<Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
											<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
											<Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />											
										</Trigger>
									</Style.Triggers>
								</Style>
							</local:TextBoxEx.Style>
						</local:TextBoxEx>

						<Button Grid.Column="1" Margin="4 0 0 0" 
                            Visibility="{TemplateBinding CopyToClipboardButtonContent, Converter={StaticResource NullToVisibilityConverter}}" 
                            Content="{TemplateBinding CopyToClipboardButtonContent}" 
                            ToolTip="{TemplateBinding CopyToClipboardButtonToolTip}" 
                            Command="{Binding CopyToClipboardCommand,RelativeSource={RelativeSource TemplatedParent}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>